# GCMotors Workshop — variables de entorno
# Copia este fichero a .env y rellena los valores. NUNCA commitear .env

# PIN del panel /admin (obligatorio). Sin él, el panel queda inaccesible.
GC_ADMIN_PIN=

# Token para tareas programadas / acceso máquina (opcional)
CRON_SECRET=

# Clave de OpenAI para el asistente con IA real (opcional).
# Sin ella, el chat funciona con su motor de reglas local.
OPENAI_API_KEY=
