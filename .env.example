# GCMotors Workshop — variables de entorno
# Copia este fichero a .env y rellena los valores. NUNCA commitear .env

# PIN del panel /admin (obligatorio). Sin él, el panel queda inaccesible.
GC_ADMIN_PIN=

# Token para tareas programadas / acceso máquina (opcional)
CRON_SECRET=

# Clave de OpenAI para el asistente con IA real (opcional).
# Sin ella, el chat funciona con su motor de reglas local.
OPENAI_API_KEY=

# Aviso de reservas por email (Resend). El dominio debe estar verificado en Resend.
RESEND_API_KEY=
RESEND_FROM=GCMotors Workshop <bookings@gcmotors-workshop.com>
BOOKING_TO_RENTALS=rentals@gcmotors-workshop.com
BOOKING_TO_REPAIRS=repairs@gcmotors-workshop.com

# Enlace de reseña de Google (opcional; si está vacío, el enlace no se muestra)
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
